#startpage.kv
<StartPage>:
    BoxUnlined:
        orientation: 'vertical'
        padding: 2
        spacing: 4
        BoxTitle:
            id: t_box_startpage
        BoxUnlined:
            orientation: 'vertical'
            spacing: 4
            BoxUnlined:
                orientation: 'vertical'
                size_hint_y: None
                height: "70dp"
                spacing: 2
                BoxUnlined:
                    orientation: 'horizontal'
                    size_hint_y: None
                    height: "30dp"
                    LabSmall:
                        id: lab_u_name
                        font_size: "14dp"
                        halign: 'left'
                        valign: 'middle'
                BoxUnlined:
                    orientation: 'horizontal'
                    size_hint_y: None
                    height: "36dp"
                    LabBig:
                        id: lab_logged_user
                        font_size: "24dp"
                        halign: 'left'
                        valign: 'middle'
                    ButClear:
                        id: but_change_user
                        font_size: "14dp"
                        size_hint_x: None
                        width: "100dp"
                        on_release: app.open_login_popup()
            BoxLined_2:
                orientation: 'vertical'
                spacing: 4
                BoxUnlined:
                    size_hint_y: None
                    height: "50dp"
                    ButClear:
                        id: but_learn
                        text: app.app_txt.get("btn_learn", "Lernen")
                        font_size: "18dp"
                        on_release: app.change_screen('left', 'page_learning')
                BoxUnlined:
                    orientation: 'horizontal'
                    size_hint_y: None
                    height: "30dp"
                    spacing: 4
                    LabSmall:
                        id: lab_new_count
                        text: ""
                        font_size: "14dp"
                        halign: 'left'
                        valign: 'middle'
                        text_size: self.size
                    LabSmall:
                        id: lab_due_count
                        text: ""
                        font_size: "14dp"
                        halign: 'right'
                        valign: 'middle'
                        text_size: self.size
                BoxUnlined:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: "40dp"
                    spacing: 2
                    LabBig:
                        text: app.base_txt.get("inf_start", "Willkommen!")
                        font_size: "16dp"
                        halign: 'center'
                        valign: 'middle'
                        text_size: self.size
                        color: 0.7, 0.7, 0.7, 1

        BoxBottom:
            id: b_box_startpage
