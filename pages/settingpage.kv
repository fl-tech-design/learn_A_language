#settingpage.kv
#: import constants constants
<SettingPage>:
    BoxLayout:
        orientation: 'vertical'
# Titelbox aus dem fil own_widgets.kv
        BoxTitle:
            id: t_box_settings
        BoxLined_2:
            id: m_box_settings
            orientation: 'vertical'
            spacing: 2
            padding: 2
            BoxUnlined:
                size_hint_y: 0.1
# Label für Titel Sprachauswahl
                LabBig:
                    id: lab_tit_lang
            BoxUnlined:
                orientation: 'vertical'
                size_hint_y: 0.2
                padding: 4, 0, 4, 0
                spacing: 2
# Box für die erste Sprache
                BoxFlag:
                    id: box_flag_1
# Box für die zweite Sprache
                BoxFlag:
                    id: box_flag_2
            BoxUnlined:
# Checkbox Eingeloggt bleiben
                size_hint_y: None
                height: "40dp"
                spacing: 4
                CheckBox:
                    id: cb_stay_logged
                    size_hint_x: None
                    width: "40dp"
                    active: False
                    on_active: root.on_stay_logged_toggle(self.active)
                LabBig:
                    text: app.app_txt.get("stay_logged_in", "Eingeloggt bleiben")
                    font_size: "18dp"
                    halign: 'left'
                    valign: 'middle'
                    text_size: self.size
            BoxUnlined:
# Box Fusszeile mit Buttons
                orientation: 'horizontal'
                size_hint_y: None
                height: "50dp"
                spacing: 4
                ButClear:
                    id: but_back_settings
                    text: app.base_txt.get("back", "Zurück")
                    font_size: "18dp"
                    on_release: app.change_screen('right', 'page_start') if app.scr_man.current == 'page_setting' else app.change_screen('left', 'page_start')
                ButClear:
                    id: but_quit_settings
                    text: app.base_txt.get("exit", "Beenden")
                    font_size: "18dp"
                    on_release: app._app_stop()
