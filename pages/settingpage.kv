#settingpage.kv
#: import constants constants
<SettingPage>:
    BoxLayout:
        orientation: 'vertical'
        BoxTitle:
            id: t_box_settings
        BoxLined_2:
            id: m_box_settings
            orientation: 'vertical'
            spacing: 2
            padding: 2
            BoxUnlined:
                size_hint_y: 0.1
                LabBig:
                    id: lab_tit_lang
            BoxUnlined:
                orientation: 'vertical'
                size_hint_y: 0.2
                padding: 4, 0, 4, 0
                spacing: 2
                BoxFlag:
                    id: box_flag_1
                BoxFlag:
                    id: box_flag_2
            BoxUnlined:
                size_hint_y: None
                height: "40dp"
                spacing: 4
                CheckBox:
                    id: cb_stay_logged
                    size_hint_x: None
                    width: "40dp"
                    active: False
                    on_active: root.on_stay_logged_toggle(self.active)
                LabBig:
                    text: app.app_txt.get("stay_logged_in", "Eingeloggt bleiben")
                    font_size: "18dp"
                    halign: 'left'
                    valign: 'middle'
                    text_size: self.size
            BoxUnlined:
                orientation: 'vertical'
                size_hint_y: None
                height: "120dp"
                spacing: 2
                LabSmall:
                    text: app.app_txt.get("words_per_session", "Wörter pro Sitzung")
                    font_size: "16dp"
                    halign: 'left'
                    valign: 'middle'
                    text_size: self.size
                BoxUnlined:
                    orientation: 'horizontal'
                    size_hint_y: None
                    height: "40dp"
                    spacing: 4
                    ToggleButton:
                        id: rb_words_3
                        group: "words_per_session"
                        text: app.app_txt.get("words_3", "3 Wörter")
                        font_size: "16dp"
                        state: "down" if app.app_data.get("words_per_session", 10) == 3 else "normal"
                        on_state: root.on_words_per_session_toggle(3, self.state)
                    ToggleButton:
                        id: rb_words_5
                        group: "words_per_session"
                        text: app.app_txt.get("words_5", "5 Wörter")
                        font_size: "16dp"
                        state: "down" if app.app_data.get("words_per_session", 10) == 5 else "normal"
                        on_state: root.on_words_per_session_toggle(5, self.state)
                    ToggleButton:
                        id: rb_words_10
                        group: "words_per_session"
                        text: app.app_txt.get("words_10", "10 Wörter")
                        font_size: "16dp"
                        state: "down" if app.app_data.get("words_per_session", 10) == 10 else "normal"
                        on_state: root.on_words_per_session_toggle(10, self.state)
            BoxUnlined:
                orientation: 'horizontal'
                size_hint_y: None
                height: "50dp"
                spacing: 4
                ButClear:
                    id: but_back_settings
                    text: app.base_txt.get("back", "Zurück")
                    font_size: "18dp"
                    on_release: root.go_back()
                ButClear:
                    id: but_quit_settings
                    text: app.base_txt.get("exit", "Beenden")
                    font_size: "18dp"
                    on_release: app._app_stop()
