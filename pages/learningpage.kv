#learningpage.kv
<LearningPage>:
    BoxUnlined:
        orientation: 'vertical'
        padding: 2
        spacing: 4
        BoxTitle:
            id: t_box_learningpage
        BoxUnlined:
            orientation: 'vertical'
            spacing: 4
            BoxUnlined:
                orientation: 'vertical'
                size_hint_y: None
                height: "200dp"
                spacing: 2
                LabBig:
                    text: "Wähle eine Kategorie"
                    font_size: "24dp"
                    halign: 'center'
                    valign: 'middle'
                    text_size: self.size
            BoxUnlined:
                orientation: 'vertical'
                spacing: 4
                BoxUnlined:
                    size_hint_y: None
                    height: "50dp"
                    ButClear:
                        id: but_new_words
                        font_size: "18dp"
                        on_release: root.go_new_words()
                BoxUnlined:
                    size_hint_y: None
                    height: "50dp"
                    ButClear:
                        id: but_review
                        font_size: "18dp"
                        on_release: root.go_review()
            BoxUnlined:
                size_hint_y: None
                height: "50dp"
                ButClear:
                    id: but_back_learning
                    font_size: "18dp"
                    on_release: root.go_back()

        BoxBottom:
            id: b_box_learningpage
