<Pop_Create_User@Popup>:
    auto_dismiss: False
    size_hint: (0.85, 0.7)
    background_color: fs22_n
    title_size: '23sp'
    title_font: constants.DIR_FONTS + "cmunobx.ttf"
    title_color: fs22_n
    separator_color: fs22_d
    separator_height: '4dp'
    BoxUnlined:
        id: box
        orientation: 'vertical'
        padding: [12, 12]
        spacing: 12
        BoxLined_1:
            orientation: 'vertical'
            padding: 10
            spacing: 10
            LabSmall:
                id: lab_inf_user_reg
                size_hint_y: None
                height: "60dp"
                font_size: "18dp"
                text_size: self.width, None
                halign: 'center'
                valign: 'middle'
            TextInput:
                id: inp_username
                multiline: False
                size_hint_y: None
                height: "48dp"
                font_size: "20dp"
                padding: 6
            LabSmall:
                id: lab_m_lang
                size_hint_y: None
                height: "44dp"
                font_size: "18dp"
            BoxUnlined:
                orientation: 'horizontal'
                size_hint_y: None
                height: "56dp"
                spacing: 12
                ToggleButton:
                    id: toggle_de
                    group: "language"
                    state: "down"
                ToggleButton:
                    id: toggle_en
                    group: "language"
        BoxCol_2:
            orientation: 'horizontal'
            size_hint_y: None
            height: "60dp"
            padding: 4
            spacing: 20
            BoxUnlined:
                ButClear:
                    id: but_confirm
                    on_release: root._save_new_user(self)
            BoxUnlined:
                ButClear:
                    id: but_chancel
                    on_release: root._close_popup()
