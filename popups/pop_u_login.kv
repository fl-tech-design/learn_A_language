<Pop_Login>:
    auto_dismiss: False
    size_hint: (0.85, 0.75)
    background_color: fs22_n
    title_size: '23sp'
    title_font: constants.DIR_FONTS + "cmunobx.ttf"
    title_color: fs22_n
    separator_color: fs22_d
    separator_height: '4dp'
    BoxUnlined:
        id: box
        orientation: 'vertical'
        padding: [12, 12]
        spacing: 12
        BoxLined_1:
            orientation: 'vertical'
            padding: 10
            spacing: 10
            ScrollView:
                do_scroll_x: False
                bar_width: '10dp'
                BoxUnlined:
                    id: user_box
                    orientation: 'vertical'
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: 8
        BoxCol_2:
            orientation: 'horizontal'
            size_hint_y: None
            height: "60dp"
            padding: 4
            spacing: 20
            BoxUnlined:
                ButClear:
                    id: but_add
                    text: "+ Neuer User"
                    font_size: "18dp"
                    on_release: root._add_user()
            BoxUnlined:
                ButClear:
                    id: but_quit
                    text: "Exit"
                    font_size: "18dp"
                    on_release: app._app_stop()
